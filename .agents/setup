#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
SECONDS=0
node -e 'if (Number(process.versions.node.split(".")[0]) < 20) throw new Error("Node 20+ required")'
version="$(node -p 'require("./package.json").packageManager.replace(/^pnpm@/, "")')"
if ! command -v pnpm >/dev/null || [[ "$(pnpm --version)" != "$version" ]]; then
  npm install --global "pnpm@$version" --no-audit --no-fund
fi
echo "Installing locked dependencies..."
pnpm install --frozen-lockfile
pnpm build
echo "Fluent orb ready in ${SECONDS}s. No API credentials needed."
