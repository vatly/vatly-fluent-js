{
  "name": "@getvatly/fluent",
  "version": "0.1.0-alpha.1",
  "description": "Framework-agnostic TypeScript billing for Vatly, the European Merchant of Record for AI, software and digital products",
  "keywords": ["vatly", "merchant-of-record", "billing", "payments", "subscriptions", "vat", "ai", "typescript"],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vatly/vatly-fluent-js.git"
  },
  "homepage": "https://github.com/vatly/vatly-fluent-js#readme",
  "bugs": { "url": "https://github.com/vatly/vatly-fluent-js/issues" },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist", "README.md", "PORTING.md", "CHANGELOG.md", "docs", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@9.15.0",
  "publishConfig": { "access": "public", "tag": "latest", "provenance": true },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --platform neutral --target es2022",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "prepack": "pnpm build"
  },
  "peerDependencies": { "@getvatly/sdk": "0.3.0-alpha.2" },
  "devDependencies": {
    "@getvatly/sdk": "0.3.0-alpha.2",
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "tsup": "^8.3.0",
    "vitest": "^2.1.0"
  }
}
